{
  // ============================================================
  //  Cloudflare Workers 정적 자산 배포 설정
  // ============================================================
  //  Cloudflare가 Pages와 Workers를 통합하면서, 신규 프로젝트는
  //  Workers 쪽으로 안내됩니다. 이 파일이 있으면 대시보드에서
  //  출력 디렉토리를 따로 설정하지 않아도 배포됩니다.
  //
  //  Pages로 배포할 경우 이 파일은 무시되므로 그대로 두어도 됩니다.
  //
  //  name 은 Cloudflare 프로젝트명과 같아야 합니다.
  // ============================================================
  "name": "demo-books",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": "./dist"
  }
}
